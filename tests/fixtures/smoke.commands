-- polydb smoke script: one pass through all three data models.
-- Run with:  polydb --memory < tests/fixtures/smoke.commands
-- Expected output is in tests/fixtures/smoke.expected (no timestamps, no generated ids).
CREATE TABLE users (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, city TEXT)
INSERT INTO users VALUES (1, 'Ada', 36, 'London'), (2, 'Linus', 54, 'Portland'), (3, 'Grace', 85, 'NYC')
CREATE INDEX users_city ON users (city)
SELECT name, age FROM users WHERE age > 40 ORDER BY age DESC
SELECT city, COUNT(*) FROM users GROUP BY city ORDER BY city
UPDATE users SET age = age + 1 WHERE id = 1
SELECT age FROM users WHERE id = 1
