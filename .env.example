# Copy to .env (gitignored). Every value here is read by engine/config.py.
PG_FED_DSN=postgresql://polystore:polystore@localhost:5432/fed
PG_CONS_DSN=postgresql://polystore:polystore@localhost:5433/cons
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fed

# Data generation (HS2 §5.3, §11.2): seed 1 is the development seed.
SEED=1
SCALE=0.01

# Container parity (HS2 §8.3). Adjust to your core count, see docs/ENVIRONMENT.md.
DB_CPUSET=2,3
DB_CPUS=2
DB_MEM=3g
