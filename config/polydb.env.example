# polydb server configuration, read by scripts/serve.sh.
# Copy to config/polydb.env and edit; that copy is ignored by git.
# polydb itself reads no environment variables: scripts/serve.sh turns
# these values into the command-line flags shown in the comments.
#
# There are no credentials in this file because polydb has no
# authentication (see README, "External interfaces").

# Directory holding data.wal and data.snap. Empty = in-memory (--memory).
POLYDB_DATA_DIR=polydb-data

# Address to bind (--host). Keep 127.0.0.1 unless the network is trusted.
POLYDB_HOST=127.0.0.1

# Ports (--port, --redis-port, --pg-port, --mongo-port). "off" disables one.
# tests/drivers.py expects the default Redis, PostgreSQL and MongoDB ports.
POLYDB_PORT=7878
POLYDB_REDIS_PORT=6380
POLYDB_PG_PORT=5433
POLYDB_MONGO_PORT=27018
